<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"operator-simulator"}</customFields>
            <includeMdcKeyName>correlationId</includeMdcKeyName>
            <includeMdcKeyName>bookingId</includeMdcKeyName>
            <includeMdcKeyName>attemptNumber</includeMdcKeyName>
            <includeMdcKeyName>operatorBookingId</includeMdcKeyName>
            <includeMdcKeyName>exceptionType</includeMdcKeyName>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
