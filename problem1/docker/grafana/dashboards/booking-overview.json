{
  "id": null,
  "uid": "booking-overview",
  "title": "Booking Overview",
  "tags": ["debugathon"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "Booking Request Rate", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(booking_requests_total[5m])", "legendFormat": "requests/sec", "refId": "A" }
      ]
    },
    {
      "id": 2, "title": "Booking Success %", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "100 * rate(booking_confirmed_total[5m]) / rate(booking_requests_total[5m])", "legendFormat": "success %", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 3, "title": "Booking Failure %", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "100 * rate(booking_failed_total[5m]) / rate(booking_requests_total[5m])", "legendFormat": "failure %", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 4, "title": "Booking Latency P95/P99", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(booking_request_duration_seconds_bucket[5m]))", "legendFormat": "p95", "refId": "A" },
        { "expr": "histogram_quantile(0.99, rate(booking_request_duration_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5, "title": "Operator Latency P95/P99", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(operator_request_duration_seconds_bucket[5m]))", "legendFormat": "p95", "refId": "A" },
        { "expr": "histogram_quantile(0.99, rate(operator_request_duration_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6, "title": "Operator HTTP Error Rate", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(http_server_requests_seconds_count{job=\"operator-simulator\", outcome=\"SERVER_ERROR\"}[5m])", "legendFormat": "5xx/sec", "refId": "A" }
      ]
    },
    {
      "id": 7, "title": "Payment Latency P95", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(payment_request_duration_seconds_bucket[5m]))", "legendFormat": "p95", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 8, "title": "Payment Error Rate", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(payment_errors_total[5m])", "legendFormat": "errors/sec", "refId": "A" }
      ]
    },
    {
      "id": 9, "title": "CPU Usage", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "process_cpu_usage", "legendFormat": "{{job}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 10, "title": "JVM Heap Used", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"heap\"}", "legendFormat": "{{job}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 11, "title": "Postgres Active Connections", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(hikaricp_connections_active) by (job)", "legendFormat": "{{job}}", "refId": "A" }
      ]
    }
  ]
}
