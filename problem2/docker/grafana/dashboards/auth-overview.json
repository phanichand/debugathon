{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Authenticated request success rate",
      "targets": [
        {
          "expr": "100 * sum(rate(auth_validation_total{result=\"success\"}[1m])) / clamp_min(sum(rate(auth_validation_total[1m])), 0.001)",
          "legendFormat": "success %"
        }
      ],
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Validation outcomes",
      "targets": [
        {
          "expr": "sum by (result) (rate(auth_validation_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}
    },
    {
      "type": "timeseries",
      "title": "Validation outcome by replica",
      "targets": [
        {
          "expr": "sum by (pod, result) (rate(auth_validation_total[1m]))",
          "legendFormat": "{{pod}} / {{result}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}
    },
    {
      "type": "timeseries",
      "title": "Login rate by replica",
      "targets": [
        {
          "expr": "sum by (pod) (rate(auth_login_total[1m]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}
    },
    {
      "type": "timeseries",
      "title": "Redis exporter health",
      "targets": [
        {
          "expr": "redis_up",
          "legendFormat": "redis"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}
    }
  ],
  "schemaVersion": 39,
  "tags": ["debugathon", "problem2"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "title": "Problem 2 — Authentication Overview",
  "version": 1
}
